{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": { "value": "x64", "strategy": "external" },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/external/openvino/runtime/cmake"
            }
        },
        {
            "name": "dev",
            "inherits": "base",
            "displayName": "Dev (Debug)",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "dev", "configurePreset": "dev" },
        { "name": "release", "configurePreset": "release" }
    ],
    "testPresets": [
        { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
        { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
        {
            "name": "ci-dev",
            "configurePreset": "dev",
            "output": { "outputOnFailure": true },
            "filter": { "exclude": { "label": "microphone|gpu" } }
        },
        {
            "name": "ci-release",
            "configurePreset": "release",
            "output": { "outputOnFailure": true },
            "filter": { "exclude": { "label": "microphone|gpu" } }
        }
    ],
    "workflowPresets": [
        {
            "name": "dev",
            "displayName": "Dev: configure, build, test",
            "steps": [
                { "type": "configure", "name": "dev" },
                { "type": "build", "name": "dev" },
                { "type": "test", "name": "dev" }
            ]
        },
        {
            "name": "release",
            "displayName": "Release: configure, build, test",
            "steps": [
                { "type": "configure", "name": "release" },
                { "type": "build", "name": "release" },
                { "type": "test", "name": "release" }
            ]
        },
        {
            "name": "ci-dev",
            "displayName": "CI dev: no hardware-labelled tests",
            "steps": [
                { "type": "configure", "name": "dev" },
                { "type": "build", "name": "dev" },
                { "type": "test", "name": "ci-dev" }
            ]
        },
        {
            "name": "ci-release",
            "displayName": "CI release: no hardware-labelled tests",
            "steps": [
                { "type": "configure", "name": "release" },
                { "type": "build", "name": "release" },
                { "type": "test", "name": "ci-release" }
            ]
        }
    ]
}
