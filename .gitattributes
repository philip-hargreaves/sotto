* text=auto eol=lf

# cmd.exe needs CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Visual Studio rewrites the solution with CRLF on every save
*.slnx text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.onnx binary
*.bin binary
*.pfx binary
*.cer binary
*.msix binary
*.appx binary
