<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Controls.LevelRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <!-- Behind whatever sits in the same cell: a soft accent glow with no edge
         that brightens and reaches further with the level, and one hairline
         ring that eases outward from the disc. Colours come from the accent
         token in code so they follow the theme -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Ellipse x:Name="Glow" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse
            x:Name="Ring"
            StrokeThickness="1.25"
            RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
