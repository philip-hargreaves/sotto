<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Views.ConsultationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One card on the Mica; the backdrop stays visible around it -->
    <Border Margin="8,0,8,8" Style="{StaticResource CardSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="16,0" VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind Controls.ReviewVisible, Mode=OneWay}">
                    <Button Command="{x:Bind Controls.NewConsultationCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="New consultation" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Shares the cell with New consultation; read-only while recording -->
                <DropDownButton
                    x:Name="MicPicker"
                    IsEnabled="{x:Bind Controls.MicPickerEnabled, Mode=OneWay}"
                    Style="{StaticResource TrayButton}"
                    ToolTipService.ToolTip="{x:Bind MicTip, Mode=OneWay}"
                    Visibility="{x:Bind Controls.MicPickerVisible, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE720;" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource MutedTextBrush}"
                                   Text="{x:Bind Mic.Label, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="MicFlyout" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button
                        VerticalAlignment="Center"
                        Style="{StaticResource TrayButton}"
                        ToolTipService.ToolTip="About Ambient">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <ScrollViewer MaxHeight="560">
                                    <StackPanel MaxWidth="400" Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="About" />
                                        <TextBlock TextWrapping="Wrap"
                                            Text="Ambient produces a draft transcript, clinical note and patient information sheet from a consultation. The patient sheet can also be translated into the patient's own language. Every document is a draft for a clinician to review and edit - nothing is final until a clinician has checked it." />
                                        <TextBlock TextWrapping="Wrap"
                                            Text="This app is a demonstrative product, developed by Philip Hargreaves in collaboration with Intel and the NHS. It is for demonstration and evaluation only, and is not for use in real clinical settings." />
                                        <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Disclaimer" />
                                        <TextBlock TextWrapping="Wrap"
                                            Text="&#x2022;  Ambient does not diagnose, recommend treatment or add clinical information of its own. It is not a medical device." />
                                        <TextBlock TextWrapping="Wrap"
                                            Text="&#x2022;  Automatic transcription, drafting and translation make mistakes - missed words, wrong speaker labels, wording that changes meaning. Ambient is built on the principle that a clinician checks every document against what was actually said." />
                                        <TextBlock TextWrapping="Wrap"
                                            Text="&#x2022;  Nothing Ambient produces is a substitute for clinical judgement; responsibility for any clinical record always rests with a clinician." />
                                        <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Privacy" />
                                        <TextBlock TextWrapping="Wrap"
                                            Text="Everything runs on device. Audio, transcripts, notes and translations are processed and stored locally; nothing leaves the device." />
                                        <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Minimum system requirements" />
                                        <TextBlock TextWrapping="Wrap"
                                            Text="&#x2022;  Windows 11, 64-bit&#x0a;&#x2022;  Intel Core Ultra Series 2 processor with Intel Arc iGPU&#x0a;&#x2022;  32 GB RAM&#x0a;&#x2022;  20 GB free disk space, for the models and their compiled caches" />
                                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}"
                                            Text="Developed and tested on an Intel Core Ultra 9 285H with Intel Arc 140T graphics and 64 GB RAM." />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        VerticalAlignment="Center"
                        Command="{x:Bind Shell.ShowSessionsCommand}"
                        Style="{StaticResource TrayButton}"
                        ToolTipService.ToolTip="Sessions">
                        <FontIcon FontSize="16" Glyph="&#xE81C;" />
                    </Button>
                    <Button
                        VerticalAlignment="Center"
                        Command="{x:Bind Shell.ShowSettingsCommand}"
                        Style="{StaticResource TrayButton}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- One region, two occupants: the record control while idle or
                 recording, the documents from the stop onward -->
            <Grid Grid.Row="1" Margin="8,0">
                <ContentControl
                    x:Name="ControlsHost"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Visibility="{x:Bind Controls.CentreStageVisible, Mode=OneWay}" />
                <Grid ColumnSpacing="20" Visibility="{x:Bind Controls.PanesVisible, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="16" />
                        </TransitionCollection>
                    </Grid.ChildrenTransitions>
                    <!-- No pane containers: the content items are the cards,
                         floating on the layer the way the turns do -->
                    <ContentControl
                        x:Name="TranscriptHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
                    <ContentControl
                        x:Name="NoteHost"
                        Grid.Column="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
                </Grid>
            </Grid>

            <ContentControl
                x:Name="DemoTrayHost"
                Grid.Row="2"
                Margin="8,8,8,0"
                HorizontalContentAlignment="Stretch"
                Visibility="Collapsed" />

            <ContentControl
                x:Name="StatusHost"
                Grid.Row="3"
                Margin="0,8,0,0"
                HorizontalContentAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>
