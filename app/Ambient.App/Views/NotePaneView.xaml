<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.NotePaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TabView
        Padding="16,8"
        CanDragTabs="False"
        CanReorderTabs="False"
        IsAddTabButtonVisible="False"
        TabWidthMode="SizeToContent">
        <TabView.TabItems>

            <TabViewItem Header="Clinical note" IsClosable="False">
                <ContentControl
                    x:Name="NoteHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </TabViewItem>

            <TabViewItem Header="Patient information" IsClosable="False">
                <ContentControl
                    x:Name="PatientHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </TabViewItem>

        </TabView.TabItems>
    </TabView>
</UserControl>
