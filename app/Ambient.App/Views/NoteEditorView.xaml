<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Views.NoteEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="0,10,0,8" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top right produces the document; bottom left takes it away;
             bottom right is the edit lifecycle -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing
                    Width="14"
                    Height="14"
                    IsActive="{x:Bind ViewModel.NotePreparing, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.NotePreparing, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource MicroText}"
                    Text="{x:Bind ViewModel.NoteStateCaption, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.NoteCaptionVisible, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource MicroText}"
                    Text="{x:Bind ViewModel.EditedStamp, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Edited, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <!-- A refusal shows its reason and one way past it -->
                <TextBlock
                    Style="{StaticResource MicroText}"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.RefusalReason, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.NoteRefused, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.WriteAnywayCommand}"
                    Content="Write a note anyway"
                    Visibility="{x:Bind ViewModel.CanWriteAnyway, Mode=OneWay}" />
                <ComboBox
                    x:Name="StyleBox"
                    MinWidth="104"
                    AutomationProperties.Name="Note style"
                    IsEnabled="{x:Bind ViewModel.NoteDocumentReady, Mode=OneWay}"
                    SelectionChanged="OnStyleChanged">
                    <ComboBoxItem Content="Prose" Tag="prose" />
                    <ComboBoxItem Content="SOAP" Tag="soap" />
                </ComboBox>
                <ComboBox
                    x:Name="DetailBox"
                    MinWidth="118"
                    AutomationProperties.Name="Note detail"
                    IsEnabled="{x:Bind ViewModel.NoteDocumentReady, Mode=OneWay}"
                    SelectionChanged="OnDetailChanged">
                    <ComboBoxItem Content="Concise" Tag="concise" />
                    <ComboBoxItem Content="Standard" Tag="standard" />
                    <ComboBoxItem Content="Detailed" Tag="detailed" />
                </ComboBox>
                <Button x:Name="RegenerateButton"
                        Command="{x:Bind ViewModel.RegenerateCommand}"
                        ToolTipService.ToolTip="Rewrite the note with the chosen style and detail">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Regenerate" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The clinician's document; editable in place. The minimum keeps
             it a document when short or hosted in an unbounded column -->
        <TextBox
            x:Name="NoteBox"
            Grid.Row="1"
            MinHeight="140"
            IsHitTestVisible="{x:Bind ViewModel.NoteEditing, Mode=OneWay}"
            IsReadOnly="{x:Bind ViewModel.NoteViewing, Mode=OneWay}"
            IsTabStop="{x:Bind ViewModel.NoteEditing, Mode=OneWay}"
            Style="{StaticResource DocumentTextBox}"
            Text="{x:Bind ViewModel.ClinicalNoteText, Mode=TwoWay}" />

        <Grid Grid.Row="2" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnCopyNote"
                        IsEnabled="{x:Bind ViewModel.NoteDocumentReady, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Click="OnExportNote"
                        IsEnabled="{x:Bind ViewModel.NoteDocumentReady, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.NoteViewing, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE898;" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Read-only until an explicit Edit; Save commits, Discard restores -->
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.EditNoteCommand}"
                    Visibility="{x:Bind ViewModel.NoteViewing, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{x:Bind ViewModel.DiscardNoteCommand}"
                    Content="Discard"
                    Visibility="{x:Bind ViewModel.NoteEditing, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.SaveNoteCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.NoteEditing, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                        <TextBlock Text="Save note" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- An edited note is the clinician's wording; Regenerate asks
             before replacing it -->
        <TeachingTip
            Title="Replace your edits?"
            ActionButtonCommand="{x:Bind ViewModel.ConfirmRegenerateCommand}"
            ActionButtonContent="Regenerate"
            CloseButtonCommand="{x:Bind ViewModel.KeepEditsCommand}"
            CloseButtonContent="Keep my note"
            IsOpen="{x:Bind ViewModel.RegenerateWarningOpen, Mode=TwoWay}"
            PreferredPlacement="Top"
            Subtitle="You changed this note. Regenerating writes a new note from the transcript and your changes are lost."
            Target="{x:Bind RegenerateButton}" />
    </Grid>
</UserControl>
