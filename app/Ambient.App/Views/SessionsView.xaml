<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Views.SessionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ambient.App.Core.ViewModels">

    <Grid Padding="16" ColumnSpacing="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
            <Button Click="OnBackClick" ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Sessions" />
            <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button Click="OnDeleteClick" ToolTipService.ToolTip="Delete this session">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
            </Button>
        </StackPanel>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Sessions}"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionRow">
                    <!-- The title owns the row's full width; the edited chip
                         sits on the meta line so a long title never meets it -->
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource FaintTextBrush}"
                                Text="{x:Bind Started}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource FaintTextBrush}"
                                Text="{x:Bind Duration}" />
                            <Border
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CautionSoftBrush}"
                                BorderBrush="{ThemeResource CautionBrush}"
                                Style="{StaticResource ChipBorder}"
                                Visibility="{x:Bind Edited}">
                                <TextBlock
                                    Style="{StaticResource CaptionText}"
                                    Foreground="{ThemeResource CautionBrush}"
                                    Text="{x:Bind EditedLabel}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- The open consultation: the live view's own renderers in tabs -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.DetailOpen, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <!-- The title is the label; typing here renames the session -->
                <TextBox
                    MinWidth="220"
                    AutomationProperties.Name="Consultation label"
                    FontWeight="SemiBold"
                    LostFocus="OnTitleCommitted"
                    PlaceholderText="Name this consultation"
                    Text="{x:Bind ViewModel.DetailTitle, Mode=TwoWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionText}"
                    Text="{x:Bind ViewModel.DetailMeta, Mode=OneWay}" />
                <Border
                    VerticalAlignment="Center"
                    Background="{ThemeResource CautionSoftBrush}"
                    BorderBrush="{ThemeResource CautionBrush}"
                    Style="{StaticResource ChipBorder}"
                    Visibility="{x:Bind ViewModel.Note.Edited, Mode=OneWay}">
                    <TextBlock
                        Style="{StaticResource CaptionText}"
                        Foreground="{ThemeResource CautionBrush}"
                        Text="{x:Bind ViewModel.Note.EditedStamp, Mode=OneWay}" />
                </Border>
            </StackPanel>

            <TabView
                Grid.Row="1"
                CanDragTabs="False"
                CanReorderTabs="False"
                IsAddTabButtonVisible="False"
                TabWidthMode="SizeToContent">
                <TabView.TabItems>
                    <!-- One document per tab, at a text measure: a wide pane
                         must not mean long lines and dead space. The note is
                         what a past consultation is opened for; the
                         transcript is the reference, last -->
                    <TabViewItem Header="Clinical note" IsClosable="False">
                        <ContentControl
                            x:Name="NoteHost"
                            MaxWidth="760"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                    </TabViewItem>
                    <TabViewItem Header="Patient information" IsClosable="False">
                        <ContentControl
                            x:Name="PatientHost"
                            MaxWidth="760"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                    </TabViewItem>
                    <TabViewItem Header="Transcript" IsClosable="False">
                        <ContentControl
                            x:Name="TranscriptHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                    </TabViewItem>
                </TabView.TabItems>
            </TabView>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind SelectHintVisible, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource PaneHeaderText}"
                Text="Select a consultation" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="Its transcript, note and patient sheet open here." />
        </StackPanel>

        <!-- Keep consultations is off and nothing is stored: the page says
             so instead of presenting an empty list as a mystery -->
        <StackPanel
            Grid.Row="1"
            Grid.ColumnSpan="2"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.EmptyBecauseOff, Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="{ThemeResource FaintTextBrush}"
                Glyph="&#xE72E;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource PaneHeaderText}"
                Text="Consultations are not being kept" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionText}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="Each consultation is erased when you leave it. Turn on Save consultation data in Settings to keep the transcript, note and patient sheet on this device." />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind Shell.ShowSettingsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                    <TextBlock Text="Open Settings" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
