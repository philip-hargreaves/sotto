<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Views.TranscriptPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ambient.App.Views"
    xmlns:vm="using:Ambient.App.Core.ViewModels">

    <Grid Padding="16,12,16,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PaneHeaderText}" Text="Transcript" />

        <!-- Each turn is a card, and the card IS the item container, so the
             platform's hover and theme behaviour stay underneath. The
             speaker's colour is a rounded edge, not a tint. -->
        <ListView
            x:Name="TurnList"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Turns}"
            Padding="0,0,0,8"
            SelectionMode="None">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TranscriptTurnItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle
                            Fill="{x:Bind views:SpeakerPalette.Stripe(Speaker)}"
                            RadiusX="1.5"
                            RadiusY="1.5" />
                        <StackPanel Grid.Column="1" Margin="13,10,0,10">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{x:Bind views:SpeakerPalette.Stripe(Speaker)}"
                                Style="{StaticResource CaptionText}"
                                Text="{x:Bind views:SpeakerPalette.Label(Speaker)}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                Style="{StaticResource MicroText}"
                                Text="{x:Bind TimeLabel}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Margin="0,10,14,10"
                            Style="{StaticResource BodyText}"
                            Text="{x:Bind Text}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
