<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Views.SessionControlsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ambient.App.Controls"
    xmlns:vm="using:Ambient.App.Core.ViewModels">

    <!-- The centre holds the one action -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel
            HorizontalAlignment="Center"
            Spacing="14"
            Visibility="{x:Bind ViewModel.IdleVisible, Mode=OneWay}">
            <Button
                AutomationProperties.Name="Start recording"
                Command="{x:Bind ViewModel.StartRecordingCommand}"
                Style="{StaticResource RecordDisc}">
                <FontIcon FontSize="32" Glyph="&#xE720;" />
            </Button>
            <!-- The one action on screen carries the one large label -->
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Start recording" />
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Center"
            Spacing="14"
            Visibility="{x:Bind ViewModel.RecordingVisible, Mode=OneWay}">
            <!-- The ring breathes with the microphone behind the disc -->
            <Grid HorizontalAlignment="Center">
                <controls:LevelRing Diameter="88" Level="{x:Bind ViewModel.Level, Mode=OneWay}" />
                <Button
                    AutomationProperties.Name="Stop recording"
                    Command="{x:Bind ViewModel.StopRecordingCommand}"
                    Style="{StaticResource StopDisc}">
                    <FontIcon FontSize="28" Glyph="&#xE71A;" />
                </Button>
            </Grid>
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource ClockText}"
                Text="{x:Bind ViewModel.ElapsedLabel, Mode=OneWay}" />


            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.CancelRecordingCommand}"
                Content="Cancel"
                Style="{StaticResource TrayButton}" />
        </StackPanel>

        <!-- Stop pressed, transcript still sealing: the same region, one
             caption, until there is something to show -->
        <StackPanel
            HorizontalAlignment="Center"
            Spacing="14"
            Visibility="{x:Bind ViewModel.FinalisingVisible, Mode=OneWay}">
            <ProgressRing
                Width="44"
                Height="44"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.FinalisingVisible, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.FinalisingLabel, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource ClockText}"
                Text="{x:Bind ViewModel.ElapsedLabel, Mode=OneWay}" />
        </StackPanel>
        <!-- No note: the same region says so and offers the way out -->
        <StackPanel
            MaxWidth="420"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.RefusedVisible, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="This recording did not contain enough clinical information to write a note." />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.Note.WriteAnywayCommand}"
                    Content="Write a note anyway"
                    Visibility="{x:Bind ViewModel.Note.CanWriteAnyway, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.DoneCommand}"
                    Content="Done"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
