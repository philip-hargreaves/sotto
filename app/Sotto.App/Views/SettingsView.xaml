<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Command="{x:Bind Shell.GoBackCommand}" ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Heading}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="12">
            <ToggleSwitch
                Header="Demo tray"
                IsOn="{x:Bind ViewModel.DemoTrayEnabled, Mode=TwoWay}"
                OffContent="Hidden"
                OnContent="Shown" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Replays a recorded consultation through the full pipeline, for testing and demos. Not a clinical feature."
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Model tiers, privacy, devices and performance reporting land here as their features arrive."
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
