<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Command="{x:Bind Shell.GoBackCommand}" ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Heading}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="12">
            <ToggleSwitch
                Header="Save consultation data"
                IsOn="{x:Bind ViewModel.KeepConsultations, Mode=TwoWay}"
                OffContent="Off"
                OnContent="On" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Keeps the transcript, note and patient sheet of each consultation on this device, encrypted, until you delete it. Audio is never kept. Applies to consultations from now on; earlier ones are unchanged."
                TextWrapping="Wrap" />
            <ToggleSwitch
                Header="Demo tray"
                IsOn="{x:Bind ViewModel.DemoTrayEnabled, Mode=TwoWay}"
                OffContent="Hidden"
                OnContent="Shown" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Replays a recorded consultation through the full pipeline, for testing and demos. Not a clinical feature."
                TextWrapping="Wrap" />
            <ToggleSwitch
                Header="Low-power transcription"
                IsOn="{x:Bind ViewModel.NpuTranscription, Mode=TwoWay}"
                OffContent="GPU"
                OnContent="NPU" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Runs transcription on the NPU to save battery. The engine restarts to apply; the first switch prepares the model and can take a few minutes."
                TextWrapping="Wrap" />
            <ToggleSwitch
                Header="Show performance metrics"
                IsOn="{x:Bind ViewModel.ShowPerformanceMetrics, Mode=TwoWay}"
                OffContent="Hidden"
                OnContent="Shown" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Shows the models at work in the status bar - device, transcription speed, writing speed and memory use. For testing, not a clinical feature."
                TextWrapping="Wrap" />
            <ToggleSwitch
                Header="Collect performance data"
                IsOn="{x:Bind ViewModel.CollectPerformanceData, Mode=TwoWay}"
                OffContent="Off"
                OnContent="On" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Records timings, device names and memory use per session - never audio or text - to a local file (metrics.jsonl in the app's data folder), for comparing hardware."
                TextWrapping="Wrap" />
            <Button Command="{x:Bind ViewModel.ExportPerformanceReportCommand}" Content="Export performance report" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind ViewModel.ExportResult, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Model tiers and privacy land here as their features arrive."
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
