<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.NotePaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sotto.App.Core.ViewModels">

    <TabView Padding="16,8" IsAddTabButtonVisible="False">
        <TabView.TabItems>

            <TabViewItem Header="Clinical note" IsClosable="False">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Foreground="{ThemeResource DoctorBrush}"
                        Text="{x:Bind ViewModel.PipelineState, Mode=OneWay}" />
                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.ClinicalNoteText, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Patient information" IsClosable="False">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Foreground="{ThemeResource PatientBrush}"
                        Text="{x:Bind ViewModel.PipelineState, Mode=OneWay}" />
                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.PatientInfoText, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                </Grid>
            </TabViewItem>

        </TabView.TabItems>
    </TabView>
</UserControl>
