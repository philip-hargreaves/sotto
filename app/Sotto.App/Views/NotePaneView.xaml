<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.NotePaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sotto.App.Core.ViewModels">

    <TabView
        Padding="16,8"
        CanDragTabs="False"
        CanReorderTabs="False"
        IsAddTabButtonVisible="False"
        TabWidthMode="SizeToContent">
        <TabView.TabItems>

            <TabViewItem Header="Clinical note" IsClosable="False">
                <Grid Padding="0,10,0,8" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.NoteCaptionVisible, Mode=OneWay}">
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{x:Bind ViewModel.NotePreparing, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.NotePreparing, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource MicroText}"
                            Text="{x:Bind ViewModel.NoteStateCaption, Mode=OneWay}" />
                    </StackPanel>

                    <!-- The clinician's document; editable in place -->
                    <TextBox
                        Grid.Row="1"
                        Style="{StaticResource DocumentTextBox}"
                        Text="{x:Bind ViewModel.ClinicalNoteText, Mode=TwoWay}" />
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Patient information" IsClosable="False">
                <Grid Padding="0,10,0,8" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.PatientCaptionVisible, Mode=OneWay}">
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{x:Bind ViewModel.PatientPreparing, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.PatientPreparing, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource MicroText}"
                            Text="{x:Bind ViewModel.PatientStateCaption, Mode=OneWay}" />
                    </StackPanel>

                    <TextBox
                        Grid.Row="1"
                        Style="{StaticResource DocumentTextBox}"
                        Text="{x:Bind ViewModel.PatientInfoText, Mode=TwoWay}" />

                    <!-- Only once there is a sheet to translate -->
                    <Grid
                        Grid.Row="2"
                        Margin="0,2,0,0"
                        ColumnSpacing="8"
                        Visibility="{x:Bind ViewModel.TranslateRowVisible, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                            PlaceholderText="Language"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.TranslateCommand}"
                            Content="Translate"
                            Style="{StaticResource AccentButtonStyle}" />
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.TranslationRunning, Mode=OneWay}">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{x:Bind ViewModel.TranslationRunning, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource MicroText}" Text="Translating" />
                        </StackPanel>
                    </Grid>

                    <TextBox
                        Grid.Row="3"
                        MaxHeight="260"
                        IsReadOnly="True"
                        Style="{StaticResource DocumentTextBox}"
                        Text="{x:Bind ViewModel.TranslationText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.TranslationVisible, Mode=OneWay}" />
                </Grid>
            </TabViewItem>

        </TabView.TabItems>
    </TabView>
</UserControl>
