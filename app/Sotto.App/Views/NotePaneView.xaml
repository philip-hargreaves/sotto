<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.NotePaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sotto.App.Core.ViewModels">

    <TabView Padding="16,8" IsAddTabButtonVisible="False">
        <TabView.TabItems>

            <TabViewItem Header="Clinical note" IsClosable="False">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Foreground="{ThemeResource DoctorBrush}"
                        Text="{x:Bind ViewModel.PipelineState, Mode=OneWay}" />
                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.ClinicalNoteText, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Patient information" IsClosable="False">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Foreground="{ThemeResource PatientBrush}"
                        Text="{x:Bind ViewModel.PipelineState, Mode=OneWay}" />
                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.PatientInfoText, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ComboBox
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                            PlaceholderText="Language"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                        <Button
                            Command="{x:Bind ViewModel.TranslateCommand}"
                            Content="Translate" />
                    </StackPanel>
                    <TextBox
                        Grid.Row="3"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.TranslationText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>
            </TabViewItem>

        </TabView.TabItems>
    </TabView>
</UserControl>
