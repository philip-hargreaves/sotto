<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.DemoTrayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:demo="using:Sotto.App.Core.Demo">

    <!--  Visibly non-clinical: muted surface, DEMO tag, one slim row  -->
    <Border
        Padding="12,4"
        Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="DEMO" />

            <ComboBox
                Grid.Column="1"
                MinWidth="180"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedTrack, Mode=TwoWay}"
                ToolTipService.ToolTip="Recording to replay">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="demo:DemoTrack">
                        <TextBlock Text="{x:Bind Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="OnBrowse"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Replay a wav file...">
                <FontIcon FontSize="13" Glyph="&#xE838;" />
            </Button>

            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsReplaying, Mode=OneWay}">
                <ProgressBar
                    Width="160"
                    VerticalAlignment="Center"
                    Maximum="1"
                    Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
            </StackPanel>

            <Button
                Grid.Column="4"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.CycleSpeedCommand}"
                Content="{x:Bind ViewModel.SpeedLabel, Mode=OneWay}"
                FontSize="12"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Replay speed; applies from the next replay. Results are only trusted at 1x - faster is a smoke run." />

            <ToggleButton
                Grid.Column="5"
                VerticalAlignment="Center"
                IsChecked="{x:Bind ViewModel.MonitorAudio, Mode=TwoWay}"
                ToolTipService.ToolTip="Play the recording aloud, sped up with the replay speed.">
                <FontIcon FontSize="13" Glyph="{x:Bind ViewModel.MonitorGlyph, Mode=OneWay}" />
            </ToggleButton>

            <Button
                Grid.Column="6"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.TogglePauseCommand}"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Pause / resume">
                <FontIcon FontSize="13" Glyph="{x:Bind ViewModel.PauseGlyph, Mode=OneWay}" />
            </Button>

            <!-- The glyph carries the colour, not the button; the tray stays flat -->
            <Button
                Grid.Column="7"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.PlayCommand}"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Replay the selected recording">
                <FontIcon FontSize="13" Glyph="&#xE768;" />
            </Button>

            <Button
                Grid.Column="8"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.StopCommand}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Stop and finalise">
                <FontIcon FontSize="13" Glyph="&#xE71A;" />
            </Button>
        </Grid>
    </Border>
</UserControl>
