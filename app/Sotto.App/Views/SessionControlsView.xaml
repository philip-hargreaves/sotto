<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.SessionControlsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sotto.App.Core.ViewModels">

    <Grid Padding="16,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Command="{x:Bind ViewModel.StartRecordingCommand}"
                Style="{StaticResource AccentButtonStyle}"
                Content="Start recording" />
            <Button Command="{x:Bind ViewModel.StopRecordingCommand}" Content="Stop" />
            <Button Command="{x:Bind ViewModel.CancelRecordingCommand}" Content="Cancel" />
            <Button Command="{x:Bind ViewModel.NewConsultationCommand}" Content="New consultation" />
        </StackPanel>

        <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Foreground="{ThemeResource RecordingBrush}"
            Text="{x:Bind ViewModel.State, Mode=OneWay}" />
    </Grid>
</UserControl>
