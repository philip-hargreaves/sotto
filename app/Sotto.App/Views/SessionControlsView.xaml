<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.SessionControlsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sotto.App.Core.ViewModels">

    <!-- One control set per state; the swap slides rather than jumps -->
    <Grid VerticalAlignment="Center">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <RepositionThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IdleVisible, Mode=OneWay}">
            <Button
                Command="{x:Bind ViewModel.StartRecordingCommand}"
                Style="{StaticResource RecordIdleButton}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE720;" />
                    <TextBlock Text="Start recording" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel
            Orientation="Horizontal"
            Spacing="12"
            Visibility="{x:Bind ViewModel.RecordingVisible, Mode=OneWay}">
            <Button
                Command="{x:Bind ViewModel.StopRecordingCommand}"
                Style="{StaticResource RecordLiveButton}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE71A;" />
                    <TextBlock Text="Stop recording" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource ClockText}" Text="{x:Bind ViewModel.ElapsedLabel, Mode=OneWay}" />
            <Button
                Command="{x:Bind ViewModel.CancelRecordingCommand}"
                Content="Cancel"
                Style="{StaticResource TrayButton}" />
        </StackPanel>

        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ReviewVisible, Mode=OneWay}">
            <Button Command="{x:Bind ViewModel.NewConsultationCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="New consultation" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
