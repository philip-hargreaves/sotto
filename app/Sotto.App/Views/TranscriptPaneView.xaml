<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.TranscriptPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Sotto.App.Views"
    xmlns:vm="using:Sotto.App.Core.ViewModels">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PaneHeaderText}" Text="Transcript" />

        <TextBlock
            Grid.Row="1"
            Style="{StaticResource MicroText}"
            Text="The transcript appears when the consultation ends"
            Visibility="{x:Bind EmptyVisible, Mode=OneWay}" />

        <!-- The stripe and label colour encode the speaker, never restyled ad hoc -->
        <ListView
            x:Name="TurnList"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Turns}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TranscriptTurnItem">
                    <Grid Margin="0,3" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel BorderThickness="3,0,0,0" Padding="7,0,0,0"
                                    BorderBrush="{x:Bind views:SpeakerPalette.Stripe(Speaker)}">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind views:SpeakerPalette.Stripe(Speaker)}"
                                Text="{x:Bind views:SpeakerPalette.Label(Speaker)}" />
                            <TextBlock Style="{StaticResource MicroText}" Text="{x:Bind TimeLabel}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource BodyText}"
                            Text="{x:Bind Text}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
