<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.ConsultationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One card on the Mica; the backdrop stays visible around it -->
    <Border Margin="8,0,8,8" Style="{StaticResource CardSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="16,0" VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    x:Name="ControlsHost"
                    HorizontalContentAlignment="Stretch" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button
                        VerticalAlignment="Center"
                        Command="{x:Bind Shell.ShowSessionsCommand}"
                        Style="{StaticResource TrayButton}"
                        ToolTipService.ToolTip="Sessions">
                        <FontIcon FontSize="16" Glyph="&#xE81C;" />
                    </Button>
                    <Button
                        VerticalAlignment="Center"
                        Command="{x:Bind Shell.ShowSettingsCommand}"
                        Style="{StaticResource TrayButton}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                Margin="8,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource InnerCardSurface}" Padding="0">
                    <ContentControl
                        x:Name="TranscriptHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
                </Border>
                <Border
                    Grid.Column="1"
                    Padding="0"
                    Style="{StaticResource InnerCardSurface}">
                    <ContentControl
                        x:Name="NoteHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
                </Border>
            </Grid>

            <ContentControl
                x:Name="DemoTrayHost"
                Grid.Row="2"
                Margin="8,8,8,0"
                HorizontalContentAlignment="Stretch"
                Visibility="Collapsed" />

            <ContentControl
                x:Name="StatusHost"
                Grid.Row="3"
                Margin="0,8,0,0"
                HorizontalContentAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>
