<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="16,6"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- One status, replaced as things happen; the ring means "in progress" -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing
                    Width="14"
                    Height="14"
                    IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionText}"
                    Text="{x:Bind ViewModel.DisplayLabel, Mode=OneWay}" />
            </StackPanel>

            <Border Grid.Column="1" />

            <!-- The two models at work, each with its live figure inside its
                 own chip; tabular figures so digits change without jitter -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Style="{StaticResource ChipBorder}"
                    Visibility="{x:Bind AsrChipVisible, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{x:Bind DotFill(ViewModel.AsrActive), Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{x:Bind AsrForeground(ViewModel.RealtimeLow), Mode=OneWay}"
                            Style="{StaticResource CaptionText}"
                            Text="{x:Bind ViewModel.AsrChip, Mode=OneWay}"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Style="{StaticResource ChipBorder}"
                    Visibility="{x:Bind NoteChipVisible, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{x:Bind DotFill(ViewModel.NoteActive), Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Style="{StaticResource CaptionText}"
                            Text="{x:Bind ViewModel.NoteChip, Mode=OneWay}"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>
                <!-- Not a worker, so no dot: ambient footprint, same grammar -->
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Style="{StaticResource ChipBorder}"
                    Visibility="{x:Bind MemoryChipVisible, Mode=OneWay}">
                    <TextBlock
                        FontSize="11"
                        Style="{StaticResource CaptionText}"
                        Text="{x:Bind ViewModel.MemoryChip, Mode=OneWay}"
                        Typography.NumeralAlignment="Tabular" />
                </Border>
            </StackPanel>

            <!-- Partner marks from Assets/logos/credits.json; edit the file
                 per showcase, never the code -->
            <StackPanel
                x:Name="CreditsRow"
                Grid.Column="3"
                Margin="8,0,0,0"
                Orientation="Horizontal"
                Spacing="12" />
        </Grid>
    </Border>
</UserControl>
