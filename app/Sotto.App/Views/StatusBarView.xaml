<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sotto.App.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="16,6"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing
                    Width="14"
                    Height="14"
                    IsActive="{x:Bind ViewModel.EngineStarting, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.EngineStarting, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionText}"
                    Text="{x:Bind ViewModel.EngineStateLabel, Mode=OneWay}" />
                <ProgressBar
                    Width="72"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource RecordingBrush}"
                    Maximum="1"
                    Minimum="0"
                    Value="{x:Bind ViewModel.MicLevel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.MicVisible, Mode=OneWay}" />
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="{x:Bind ViewModel.LatestActivity, Mode=OneWay}" />

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                Style="{StaticResource MicroText}"
                Text="{x:Bind ViewModel.PerformanceLine, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
